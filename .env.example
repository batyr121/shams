# Direct PostgreSQL connection; server only. Never NEXT_PUBLIC_.
DATABASE_URL=postgresql://ball_app:CHANGE_ME@localhost:5432/grand_ball
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Used by Docker Compose and database setup. Replace both passwords.
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_ADMIN_PASSWORD
POSTGRES_APP_PASSWORD=REPLACE_WITH_LONG_RANDOM_APPLICATION_PASSWORD
ADMIN_EMAIL=organizer@example.com
ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_ORGANIZER_PASSWORD

# Optional actual guest-facing origin used by QR codes.
PUBLIC_SITE_URL=
